#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        language_switch {
            bindings = <&lang_switch>;
            key-positions = <53 54>;
        };
    };

    macros {
        lang_switch: lang_switch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kt LALT>,
                <&macro_wait_time 30>,
                <&kp LSHIFT>,
                <&macro_wait_time 50>,
                <&kt LALT>;

            label = "LANG_SWITCH";
        };
    };

    keymap {
        compatible = "zmk,keymap";
        bindings = <
&kp ESC   &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                        &kp N6     &kp N7   &kp N8    &kp N9  &kp N0   &kp GRAVE
&kp TAB   &kp Q  &kp W  &kp E    &kp R    &kp T                         &kp Y      &kp U    &kp I     &kp O   &kp P    &kp MINUS
&kp LSHFT &kp A  &kp S  &kp D    &kp F    &kp G                         &kp H      &kp J    &kp K     &kp L   &kp SEMI &kp SQT
&kp LCTRL &kp Z  &kp X  &kp C    &kp V    &kp B      &kp LBKT  &kp RBKT &kp N      &kp M    &kp COMMA &kp DOT &kp FSLH &mo 2
                        &kp LALT &kp LGUI &kp SPACE  &mo 1     &kp RET  &kp RSHIFT &kp BSPC &kp RGUI
        >;

        default_layer {
            bindings = <
&kp ESCAPE  &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                           &kp N6   &kp N7      &kp N8     &kp N9   &kp N0    &kp BSPC
&kp TAB     &kp Q   &kp W   &kp E     &kp R     &kp T                            &kp Y    &kp U       &kp I      &kp O    &kp P     &kp MINUS
&kp LSHFT   &kp A   &kp S   &kp D     &kp F     &kp G                            &kp H    &kp J       &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL   &kp Z   &kp X   &kp C     &kp V     &kp B      &kp LBKT    &kp RBKT  &kp N    &kp M       &kp COMMA  &kp DOT  &kp FSLH  &kp RCTRL
                            &kp LALT  &kp LGUI  &kp SPACE  &mo 1       &mo 2     &kp RET  &kp RSHIFT  &kp RGUI
            >;
        };

        lower_layer {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &kp F6                   &kp F7                    &kp F8  &kp F9     &kp F10   &kp F11
&bt BT_CLR  &trans        &trans        &trans        &trans        &trans                          &kp F12                  &trans                    &trans  &trans     &kp LBKT  &kp RBKT
&trans      &trans        &trans        &trans        &kp AMPS      &kp PIPE                        &kp LEFT                 &kp DOWN                  &kp UP  &kp RIGHT  &trans    &trans
&trans      &trans        &trans        &trans        &trans        &trans        &trans    &trans  &kp KP_LEFT_PARENTHESIS  &kp KP_RIGHT_PARENTHESIS  &trans  &trans     &trans    &trans
                                        &trans        &trans        &trans        &trans    &trans  &trans                   &trans                    &trans
            >;
        };

        raise_layer {
            bindings = <
&kp GRAVE  &kp F1  &kp F2  &kp F3  &kp F4     &kp F5                       &trans          &trans          &trans         &trans            &trans    &kp EQUAL
&trans     &trans  &trans  &trans  &trans     &trans                       &trans          &trans          &trans         &trans            &trans    &trans
&trans     &trans  &trans  &trans  &mkp LCLK  &mkp RCLK                    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP   &mmv MOVE_RIGHT   &trans    &trans
&trans     &trans  &trans  &trans  &trans     &trans     &trans    &trans  &kp KP_PLUS     &trans          &kp LESS_THAN  &kp GREATER_THAN  &kp BSLH  &trans
                           &trans  &trans     &trans     &trans    &trans  &trans          &trans          &trans
            >;
        };
    };
};

